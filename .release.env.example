# No subas este archivo con valores reales. Copialo localmente como .release.env.
# Si ambos webhooks quedan vacíos, release:patch usa el webhook GitHub → Coolify
# ya configurado al hacer push. Completalos solo si querés un disparo directo.
SCALE_API_DIR=../scale-core-api
# SCALE_API_DEPLOY_WEBHOOK=https://hub.example.invalid/webhooks/deploy-api
# SCALE_WEB_DEPLOY_WEBHOOK=https://hub.example.invalid/webhooks/deploy-web
# Coolify suele aceptar GET; cambiá solamente si tu webhook exige POST.
SCALE_DEPLOY_WEBHOOK_METHOD=GET
