{
  "name": "scale-os",
  "private": true,
  "version": "1.0.56",
  "overrides": {
    "postcss": "8.5.28",
    "@prisma/config": {
      "deepmerge-ts": "8.0.0",
      "effect": "3.20.0"
    }
  },
  "scripts": {
    "release:sync": "node build-tools/sync-release-version.mjs",
    "release:check": "node build-tools/sync-release-version.mjs --check",
    "release:smoke": "node build-tools/release-smoke.mjs",
    "release:patch": "node build-tools/release-patch.mjs",
    "footer:sync": "tsx build-tools/sync-landing-footer.tsx",
    "footer:check": "tsx build-tools/sync-landing-footer.tsx --check",
    "predev": "npm run footer:sync",
    "prebuild": "npm run release:sync && npm run footer:sync",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test:docker-build-secrets": "node tests/docker-build-secrets.test.mjs",
    "test:release-regression": "node tests/release-version.test.mjs && tsx tests/data-loading-cache.test.ts && tsx tests/mobile-workspace-layout.test.ts && tsx tests/mobile-navigation.test.tsx && tsx tests/landing-routing.test.ts && node tests/registration-flow.test.mjs && node tests/release-regression-audit.test.mjs && node tests/web-presence.test.mjs && npm run test:docker-build-secrets"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/client": "^6.19.2",
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "0.468.0",
    "next": "15.5.24",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-easy-crop": "6.2.3",
    "react-hook-form": "^7.87.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/react-test-renderer": "18.3.1",
    "prisma": "^6.19.2",
    "react-test-renderer": "18.3.1",
    "tsx": "^4.23.13",
    "typescript": "5.7.2"
  }
}
